DATABASE_URL="file:./dev.db"
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Password for the seeded admin@silverskills.ai account. By default, EVERY seed run (npm run
# prisma:seed / prisma:seed:prod) resets the admin password back to this value — including on a
# production database, if you ever re-run the seed there after changing it via /admin. Set
# ADMIN_PASSWORD_LOCKED=true once you've set a real password (via /admin's "Restablecer
# contraseña") to stop future seed runs from overwriting it.
ADMIN_DEFAULT_PASSWORD=SilverSkills2026!
ADMIN_PASSWORD_LOCKED=false

# Optional: activates the full Claude-powered mentor agent + CV analysis.
# Without it, the app runs in rule-based fallback mode (still uses real job/course data & links).
ANTHROPIC_API_KEY=

# Optional: activates real LATAM job listings from Adzuna (free account at https://developer.adzuna.com/).
# Coverage is strong for Mexico/Brazil; Colombia is NOT on Adzuna's supported country list.
# Without it, jobs still come from Remotive + Arbeitnow (no key required) plus portal search deep links.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: activates real job listings covering Colombia/LATAM broadly. Request a free key by
# filling the form at https://jooble.org/api/about (manual approval, not instant).
JOOBLE_API_KEY=

# Optional: activates "olvidé mi contraseña" reset emails via Resend (free account at
# https://resend.com/). Without it, requesting a reset still works server-side (a token is
# created) but no email actually goes out — nothing breaks, the user just never receives it.
RESEND_API_KEY=
# Must be a sender Resend allows for your account — "onboarding@resend.dev" works out of the box
# before you verify your own domain.
RESEND_FROM_EMAIL=Silver Skills AI <onboarding@resend.dev>
# The deployed frontend's real origin, used to build the reset link inside the email.
FRONTEND_ORIGIN=http://localhost:5173
